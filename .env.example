# Secrets for the coach admin (api/oauth.js). Set these as Environment Variables
# in the Vercel dashboard (Project → Settings → Environment Variables).
# For local testing with `vercel dev`, copy this file to `.env` and fill it in.
# Never commit real values — the repo is public.

# The single shared password coaches type at /admin to sign in.
ADMIN_PASSWORD=

# A GitHub fine-grained Personal Access Token used by the server to commit edits.
# Scope it tightly:
#   Repository access: only BDME132/timpanogos-invitational
#   Permissions: Contents = Read and write
# Rotating this token signs everyone out.
GITHUB_TOKEN=
